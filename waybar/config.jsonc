// ===========================================================================
// GLOBAL SETTINGS
// ===========================================================================
{
    "include": [
        "modules/base.jsonc",
        "modules/custom.jsonc",
        "modules/niri.jsonc",
        "modules/sway.jsonc",
    ],

    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,

    "modules-left": [
        "custom/menu",
        "niri/workspaces",
        "sway/workspaces",
        "sway/scratchpad",
        "sway/mode",
        "mpris",
    ],
    "modules-center": [
        "clock",
        "custom/weather",
        "custom/update",
        "idle_inhibitor",
        "custom/notification-indicator",
    ],
    "modules-right": [
        "group/tray-expander",
        "bluetooth",
        "network",
        "pulseaudio",
        "power-profiles-daemon",
        "disk",
        "memory",
        "cpu",
        "temperature",
        "battery",
        "custom/power",
    ],
    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "tray-group-item",
        },
        "modules": ["custom/expand-icon", "tray"],
    },
}
