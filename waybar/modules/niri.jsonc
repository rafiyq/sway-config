{
    // ===========================================================================
    // GLOBAL SETTINGS
    // ===========================================================================
    "include": [
        "base.jsonc"
    ],

    // ===========================================================================
    // STANDARD LAYOUT (shared until per-WM overrides)
    // ===========================================================================
    "modules-left": [
        "custom/menu",
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
        "clock",
        "custom/weather",
        "custom/update",
        "idle_inhibitor",
        "custom/notification-indicator"
    ],
    "modules-right": [
        "group/tray-expander",
        "bluetooth",
        "network",
        "pulseaudio",
        "power-profiles-daemon",
        "disk",
        "memory",
        "cpu",
        "temperature",
        "battery",
        "custom/power"
    ],

    // ===========================================================================
    // NIRI-SPECIFIC MODULES
    // ===========================================================================
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    }
}
