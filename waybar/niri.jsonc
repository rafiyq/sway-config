{
    // ===========================================================================
    // GLOBAL SETTINGS
    // ===========================================================================
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,
    // ===========================================================================
    // MODULE LAYOUT
    // ===========================================================================
    "modules-left": ["custom/menu", "niri/workspaces", "mpris"],
    "modules-center": [
        "clock",
        "custom/update",
        "idle_inhibitor",
        "custom/notification-indicator",
        "custom/weather",
    ],
    "modules-right": [
        "group/tray-expander",
        "bluetooth",
        "network",
        "pulseaudio",
        "power-profiles-daemon",
        "disk",
        "memory",
        "cpu",
        "temperature",
        "battery",
        "custom/power",
    ],
    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "tray-group-item",
        },
        "modules": ["custom/expand-icon", "tray"],
    },
    "tray": {
        "icon-size": 12,
        "spacing": 17,
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": "",
        },
    },
    // ===========================================================================
    // CUSTOM INDICATORS (OMARCHY SCRIPTS)
    // ===========================================================================
    "custom/expand-icon": {
        "format": "",
        "tooltip": false,
        "on-scroll-up": "",
        "on-scroll-down": "",
        "on-scroll-left": "",
        "on-scroll-right": "",
    },
    "custom/menu": {
        "format": "",
        "on-click": "$HOME/.config/waybar/script/menu.sh app",
        "on-click-right": "xdg-terminal-exec",
        "tooltip-format": "Open Menu\n\nSuper + Space",
    },
    "custom/notification-indicator": {
        "on-click": "$HOME/.config/waybar/script/notif.sh toggle",
        "exec": "$HOME/.config/waybar/script/notif.sh status",
        "signal": 10,
        "return-type": "json",
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/script/menu.sh app",
    },
    "custom/update": {
        "format": "",
        "exec": "$HOME/.config/waybar/script/check-update.sh",
        "on-click": "$HOME/.config/waybar/script/tui.sh update",
        "tooltip-format": "Updates are available!",
        "signal": 7,
        "interval": 21600,
    },
    "custom/weather": {
        "format": "{}°",
        "tooltip": true,
        "interval": 1800,
        "exec": "cat $HOME/Downloads/wttrbar_ouput.json",
        "return-type": "json",
    },
    // ===========================================================================
    // SYSTEM HARDWARE
    // ===========================================================================
    "battery": {
        "format": "<span rise='1000'>{icon}</span> {capacity}%",
        "format-plugged": "",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10,
        },
    },
    "bluetooth": {
        "format": "",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format-connected": "Devices connected: <b>{num_connections}</b>\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": " {device_alias}",
        "tooltip-format-enumerate-connected-battery": " {device_alias}\t{device_battery_percentage}%",
        "on-click": "blueman-manager",
    },
    "clock": {
        "format": "{:L%A %H:%M}",
        "format-alt": "{:L%e %B %Y (Week %V)}",
        "tooltip-format": "<small><tt>{calendar}</tt></small>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<span color='#ff6699'><b>{}</b></span>",
            },
        },
    },
    "cpu": {
        "interval": 5,
        "format": "<span rise='1000'></span> {usage}%",
    },
    "disk": {
        "interval": 30,
        "format": "<span rise='1000'>󰋊</span> {percentage_used}%",
        "tooltip-format": "Total: \t{total}\nUsed: \t{used}\nFree: \t{free}",
        "path": "/",
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󱫖",
            "deactivated": "󰔛",
        },
    },
    "memory": {
        "format": "<span rise='1000'></span> {percentage}%",
        "tooltip-format": "{used:0.1f}G/{total:0.1f}G of RAM\n{swapUsed:0.1f}G/{swapTotal:0.1f}G of SWAP",
    },
    "mpris": {
        "format": "<span rise='1000'>{player_icon}</span> {dynamic}",
        "format-paused": "<span rise='1000'>{status_icon}</span> {dynamic}",
        "tooltip-format-playing": "Now Playing {dynamic} on {player} at {position} to {length}",
        "player-icons": {
            "default": " ",
            "mpv": " ",
        },
        "status-icons": {
            "paused": " ",
        },
        "dynamic-order": ["artist", "title", "album"],
        "title-len": 50,
        "artist-len": 20,
        "album-len": 20,
    },
    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)",
        "tooltip-format-ethernet": "Connected",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "omarchy-launch-wifi",
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile} ({driver})",
        "tooltip": true,
        "format-icons": {
            "default": "󰓅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆",
        },
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "$HOME/.config/waybar/script/tui.sh audio",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""],
        },
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": "<span rise='1000'>󰏈</span> {temperatureC}°C",
        // "format-icons": ["", "", "", ""]
    },
}
